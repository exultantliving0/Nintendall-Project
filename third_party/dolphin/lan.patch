+// Nintendall LAN game: boots it once the host has started it (from retro_run).
+bool Libretro::BootLanGame()
+{
+  std::string path;
+  std::unique_ptr<BootSessionData> session;
+  if (!Lan::TakeBoot(path, session))
+    return false;
+
+  std::unique_ptr<BootParameters> boot_params =
+      BootParameters::GenerateFromFile(path, std::move(*session));
+  if (!boot_params)
+  {
+    ERROR_LOG_FMT(BOOT, "LAN: could not read {}", path);
+    Lan::Fail("Couldn't start the game.");
+    return false;
+  }
+  SetRegionFreeFallback(*boot_params);
+
+  WindowSystemInfo wsi(WindowSystemType::Libretro, nullptr, nullptr, nullptr);
+  if (!BootManager::BootCore(Core::System::GetInstance(), std::move(boot_params), wsi))
+  {
+    ERROR_LOG_FMT(BOOT, "LAN: could not boot {}", path);
+    Lan::Fail("Couldn't start the game.");
+    return false;
+  }
+
+  Input::InitStage2();
+  if (Libretro::GetOption<bool>(Options::retroarch_core::CHEATS_IMPORT, true))
+  {
+    reload_cheats_from_ini();
+    generate_cht_from_ini(s_lan_cheats_name);
+  }
+  Lan::SetPlaying();
+  return true;
+}
