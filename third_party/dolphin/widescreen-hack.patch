--- a/Source/Core/DolphinLibretro/Video.cpp
+++ b/Source/Core/DolphinLibretro/Video.cpp
@@ -74,8 +74,26 @@
 
 int GetAdjustedBaseWidth()
 {
+  // Nintendall: with the widescreen hack on, the picture is as wide as the shape the hack draws
+  // for: 16:9, or the custom aspect ratio (e.g. 21:9 for ultrawide) with Aspect Ratio set to
+  // Custom. The hack widens the 3D view to the backbuffer's shape, and the backbuffer was always
+  // the 640-wide, about 4:3 EFB, so the hack only stretched the picture.
+  int width = EFB_WIDTH;
+  if (Libretro::Options::GetCached<bool>(Libretro::Options::gfx_settings::WIDESCREEN_HACK))
+  {
+    float target = 16.0f / 9.0f;
+    if (Libretro::Options::GetCached<int>(Libretro::Options::gfx_settings::ASPECT_RATIO) ==
+        static_cast<int>(AspectMode::Custom))
+    {
+      const int w = Config::Get(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH);
+      const int h = Config::Get(Config::GFX_CUSTOM_ASPECT_RATIO_HEIGHT);
+      if (w > 0 && h > 0)
+        target = static_cast<float>(w) / static_cast<float>(h);
+    }
+    width = (static_cast<int>(GetAdjustedBaseHeight() * target + 0.5f) + 1) & ~1;
+  }
   // VR packs both eyes side by side, each at the full width.
-  return VR::IsEnabled() ? EFB_WIDTH * 2 : EFB_WIDTH;
+  return VR::IsEnabled() ? width * 2 : width;
 }
 
 int GetAdjustedBaseHeight()
