+// More folders to look for updates and DLC in, from the frontend (Nintendall):
+// system/Cemu/game_paths.txt, one folder per line ("#" starts a comment). A
+// frontend with a games folder of its own lists it there, so an update or DLC
+// put next to the game is found the way Cemu's own game paths find it - the
+// file is read again before every title starts, so it can change while the
+// core stays loaded.
+static void libretro_add_frontend_game_paths()
+{
+	std::ifstream file(ActiveSettings::GetUserDataPath("game_paths.txt"));
+	std::string line;
+	auto& gamePaths = GetConfig().game_paths;
+	while (std::getline(file, line))
+	{
+		while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+			line.pop_back();
+		size_t start = 0;
+		while (start < line.size() && (line[start] == ' ' || line[start] == '\t'))
+			start++;
+		line.erase(0, start);
+		if (line.empty() || line[0] == '#')
+			continue;
+		std::error_code ec;
+		if (!fs::is_directory(_utf8ToPath(line), ec))
+			continue;
+		if (std::find(gamePaths.begin(), gamePaths.end(), line) == gamePaths.end())
+		{
+			gamePaths.emplace_back(line);
+			cemuLog_log(LogType::Force, "updates and DLC (from the frontend): {}", line);
+		}
+	}
+}
